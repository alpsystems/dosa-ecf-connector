<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Inserta el QR de verificación de la DGII en el reporte de factura
        NATIVO de Odoo (account.report_invoice_document), sin tocar ningún
        formato/plantilla que el usuario haya personalizado aparte. Al usar
        el mismo punto de anclaje que el QR de pago SEPA (div#qrcode), esto
        aparece automáticamente en cualquier instalación de Odoo que tenga
        este módulo instalado, sin configuración adicional.
    -->
    <template id="report_invoice_document_dosa" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='qrcode']" position="after">
            <!--
                wkhtmltopdf (Qt WebKit) no soporta bien 'display:flex': un
                bloque flex aquí puede solaparse con la columna de Totales
                (float-end) que lo precede. Se usa un layout de bloques
                simples con 'clear:both' para evitarlo.
            -->
            <div id="dosa_ecf_qrcode" class="mb-3 avoid-page-break-inside"
                 style="clear:both;" t-if="o.dosa_url_qr">
                <img t-att-src="o._dosa_qr_img_src()" style="width:110px;height:110px;float:left;margin-right:12px;"/>
                <div class="text-muted lh-sm">
                    <p class="mb-1">
                        <strong>e-CF: </strong><span t-field="o.dosa_encf"/>
                    </p>
                    <p class="mb-1" t-if="o.dosa_codigo_seguridad">
                        <strong>Código de seguridad: </strong><span t-field="o.dosa_codigo_seguridad"/>
                    </p>
                    <p class="mb-0">
                        Comprobante Fiscal Electrónico. Verifique este documento en
                        <a t-att-href="o.dosa_url_qr" target="_blank">ecf.dgii.gov.do</a>
                    </p>
                </div>
                <div style="clear:both;"/>
            </div>
        </xpath>
    </template>
</odoo>

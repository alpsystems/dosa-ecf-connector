<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dosa" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dosa</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Dosasystems (e-CF DGII)" name="dosa_ecf_setting_container">
                    <setting string="Credenciales de Dosasystems" help="Datos de conexión con Dosa Invoice Cloud (dosasystem.com)">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="dosa_base_url" class="col-3 col-lg-3 o_light_label"/>
                                <field name="dosa_base_url" class="col-9 col-lg-6"/>
                            </div>
                            <div class="row mt8">
                                <label for="dosa_api_key" class="col-3 col-lg-3 o_light_label"/>
                                <field name="dosa_api_key" password="True" class="col-9 col-lg-6"/>
                            </div>
                            <div class="row mt8">
                                <label for="dosa_recibidas_api_key" class="col-3 col-lg-3 o_light_label"/>
                                <field name="dosa_recibidas_api_key" password="True" class="col-9 col-lg-6"/>
                            </div>
                            <div class="row mt8">
                                <label for="dosa_user_id" class="col-3 col-lg-3 o_light_label"/>
                                <field name="dosa_user_id" class="col-9 col-lg-6"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Emisión de e-CF" help="Decide si las facturas se envían solas a la DGII al validarlas, o si prefieres revisarlas y emitirlas tú mismo con el botón 'Emitir e-CF' de cada factura">
                        <field name="dosa_auto_emit"/>
                        <div class="text-muted">
                            Si está activo, cada factura/nota de crédito se envía a la DGII automáticamente
                            al contabilizarla. Si lo desactivas, la factura queda contabilizada en Odoo sin
                            e-CF y cualquier usuario de Facturación puede emitirla cuando quiera con el botón
                            "Emitir e-CF" en la propia factura.
                        </div>
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="dosa_default_forma_pago" class="col-3 col-lg-3 o_light_label"/>
                                <field name="dosa_default_forma_pago" class="col-9 col-lg-6"/>
                            </div>
                        </div>
                    </setting>
                    <setting string="Facturas recibidas" help="Sincronización automática de e-CF recibidos como facturas de proveedor">
                        <field name="dosa_auto_sync_recibidas"/>
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="dosa_recibidas_journal_id" class="col-3 col-lg-3 o_light_label"/>
                                <field name="dosa_recibidas_journal_id" class="col-9 col-lg-6"/>
                            </div>
                            <div class="row mt8" invisible="not dosa_recibidas_last_sync">
                                <label for="dosa_recibidas_last_sync" class="col-3 col-lg-3 o_light_label"/>
                                <field name="dosa_recibidas_last_sync" readonly="1" class="col-9 col-lg-6"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
